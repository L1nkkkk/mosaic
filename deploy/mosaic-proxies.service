[Unit]
Description=Collect private Mosaic proxy egress and IP history
After=docker.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/mosaic/collect-proxies.py
TimeoutStartSec=600
Nice=15
CPUQuota=30%
MemoryMax=192M
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mosaic/monitor
PrivateTmp=true
