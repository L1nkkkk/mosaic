[Unit]
Description=Collect private Mosaic server and bot status
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/mosaic/collect-status.py
TimeoutStartSec=25
Nice=15
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mosaic/monitor
